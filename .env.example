# CrystalCore.OS API tiers / Stripe settlement — env NAMES only.
# Crystal must provision real values in a secrets vault. Do not commit secrets.
# See docs/API-TIERS.md and config/README.md.

# Persistence (real DB TBD; local stubs use in-memory / file)
DATABASE_URL=

# Stripe customer billing layer (subscriptions, checkout, portal, webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Stripe Price IDs — PLACEHOLDER until Crystal creates Products/Prices in Stripe
STRIPE_PRICE_FREE=
STRIPE_PRICE_PAID_BASE=
STRIPE_PRICE_PAID_METERED=

# Provider / platform-managed keys (platform pays providers separately — NOT via Stripe Connect to OpenAI/Anthropic)
PROVIDER_OPENAI_API_KEY=
PROVIDER_ANTHROPIC_API_KEY=
PROVIDER_DEFAULT=

# BYOK (bring-your-own-key) mode: customers supply provider keys; Crystal charges platform fee via Stripe
BYOK_ENABLED=
BYOK_ALLOWED_PROVIDERS=

# Free-tier hard caps / circuit breaker (amounts TBD by Crystal — set after policy exists)
FREE_TIER_DAILY_PROVIDER_SPEND_CEILING=
FREE_TIER_MONTHLY_PROVIDER_SPEND_CEILING=
CIRCUIT_BREAKER_ENABLED=

# Auth
API_KEY_PEPPER=
API_KEY_PREFIX=

# App
NODE_ENV=
API_BASE_URL=

# Creation platforms (pluggable: music/video/image/design/voice — Suno-class, CapCut-class, etc.)
CREATION_PLATFORMS_ENABLED=
CREATION_PLATFORM_CATALOG_PATH=
